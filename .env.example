# Environment Configuration Template
# Copy to .env.dev for local development (never commit .env.dev)

# Environment identifier
ENVIRONMENT=local

# Logging
LOG_LEVEL=debug

# GCP targeting (M0.2+; no cloud resources are provisioned in M0.1)
# Authenticate the toolbox with: gcloud auth application-default login
# GOOGLE_CLOUD_PROJECT=your-dev-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/app/.gcp/adc.json
# GCP_REGION=us-central1

# Firestore (M1.1, ADR-023 identity tier) — required outside local.
# The database is the named one Terraform provisions; there is no "(default)".
# FIRESTORE_PROJECT=your-dev-project-id
# FIRESTORE_DATABASE=messaging-dev

# Secret Manager (M1.2, ADR-015 §3.2) — required outside local. Holds the JWT
# signing key and the OTP pepper; Chat Mgmt refuses to start without them.
# Single-word key: SECRETS_PROJECT binds, SECRETS_PROJECT_ID would not.
# SECRETS_PROJECT=your-dev-project-id

# Memorystore (M1.2) — private VPC IP, so this is only reachable from inside
# the cluster. The AUTH string arrives as a Kubernetes secret, never a literal.
# REDIS_ADDR=10.0.0.3:6379
# REDIS_PASSWORD=

# Auth (M1.2, ADR-015 §3). Issuer and audience are validated on every token, so
# every service that mints or verifies must agree on both.
# AUTH_ISSUER=messaging-platform
# AUTH_AUDIENCE=messaging-api
# AUTH_KEYREFRESH=5m

# Service Ports
GATEWAY_HTTP_PORT=8080
GATEWAY_GRPC_PORT=9090
INGEST_HTTP_PORT=8081
INGEST_GRPC_PORT=9091
FANOUT_HTTP_PORT=8082
CHATMGMT_HTTP_PORT=8083
CHATMGMT_GRPC_PORT=9093

# OpenTelemetry (optional in local dev)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=
